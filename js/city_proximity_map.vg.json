{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Urban Escapes vs. Wilderness Isolation: Where Australians Camp",
    "subtitle": [
      "Spatially binned campground distribution (dots scale by number of campsites in area).",
      "Filter by state or tariff tier to examine infrastructure density."
    ],
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#64748b",
    "subtitleFontStyle": "italic"
  },
  "width": 760,
  "height": 500,
  "projection": {
    "type": "equirectangular",
    "center": [133.7751, -27.5],
    "scale": 700
  },
  "params": [
    {
      "name": "state_filter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "NSW", "VIC", "QLD", "WA", "SA", "TAS", "NT"],
        "labels": ["All Regions", "New South Wales", "Victoria", "Queensland", "Western Australia", "South Australia", "Tasmania", "Northern Territory"],
        "name": "Focus Area: "
      }
    },
    {
      "name": "fee_filter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Free Bushcamp ($0)", "Commercial Park ($25–$50+)"],
        "labels": ["All Campsites", "Free Bushcamps ($0)", "Paid Commercial Parks ($25–$50+)"],
        "name": "Tariff Class: "
      }
    }
  ],
  "layer": [
    {
      "description": "Base Australia Outline Map",
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f8fafc",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "100 km Urban Buffer Zone around Capitals",
      "data": {
        "url": "data/major_cities.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#d3ce7c",
        "opacity": 0.18,
        "size": 3200
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    },
    {
      "description": "Aggregated Campsite Clusters (1 Dot = Binned Cluster)",
      "data": {
        "url": "data/campsites_price_facilities.csv"
      },
      "transform": [
        {
          "filter": "state_filter === 'All' || datum.state === state_filter"
        },
        {
          "filter": "fee_filter === 'All' || datum.fee_tier === fee_filter"
        },
        {
          "bin": {"step": 0.6},
          "field": "lon",
          "as": "binned_lon"
        },
        {
          "bin": {"step": 0.6},
          "field": "lat",
          "as": "binned_lat"
        },
        {
          "aggregate": [{"op": "count", "as": "site_count"}],
          "groupby": ["binned_lon", "binned_lat", "fee_tier"]
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "#0f172a",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {"field": "binned_lon", "type": "quantitative"},
        "latitude": {"field": "binned_lat", "type": "quantitative"},
        "size": {
          "field": "site_count",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [5, 20, 50],
            "range": [25, 70, 140, 260]
          },
          "legend": {
            "title": "Campsites per Zone",
            "orient": "bottom-left"
          }
        },
        "color": {
          "field": "fee_tier",
          "type": "nominal",
          "scale": {
            "domain": ["Free Bushcamp ($0)", "Commercial Park ($25–$50+)"],
            "range": ["#10450C", "#32D926"]
          },
          "legend": {"title": "Campground Type", "orient": "bottom-right"}
        },
        "tooltip": [
          {"field": "site_count", "type": "quantitative", "title": "Campsites in Zone"},
          {"field": "fee_tier", "type": "nominal", "title": "Tariff Class"}
        ]
      }
    },
    {
      "description": "Major Capital City Markers",
      "data": {
        "url": "data/major_cities.csv"
      },
      "mark": {
        "type": "point",
        "shape": "diamond",
        "size": 110,
        "fill": "#1e293b",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [
          {"field": "city", "type": "nominal", "title": "Capital City"},
          {"field": "camping_driver", "type": "nominal", "title": "Why Campers Travel"}
        ]
      }
    },
    {
      "description": "City Label Text",
      "data": {
        "url": "data/major_cities.csv"
      },
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 11,
        "dy": -14,
        "color": "#ee9105"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "city", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}