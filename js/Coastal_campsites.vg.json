{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Where Are Most Campsites Located?",
    "subtitle": [
      "Dot density map: each dot represents a spatial cluster of 3 campsites.",
      "Source: OpenStreetMap Australia (OSM), N = 9,930"
    ],
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#64748b",
    "subtitleFontStyle": "italic"
  },
  "width": 750,
  "height": 520,
  "projection": {
    "type": "equirectangular",
    "center": [133.7751, -26.5],
    "scale": 780
  },
  "layer": [
    {
      "description": "Base Australia map",
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f5f2e6",
        "stroke": "#afb7c2",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "Dot map (1 dot = 3 campsites)",
      "data": {
        "url": "data/campsites_coastal_distribution.csv"
      },
      "transform": [
        {
          "bin": {"step": 0.35},
          "field": "lon",
          "as": ["binned_lon", "binned_lon_end"]
        },
        {
          "bin": {"step": 0.35},
          "field": "lat",
          "as": ["binned_lat", "binned_lat_end"]
        },
        {
          "calculate": "(datum.binned_lon + datum.binned_lon_end) / 2",
          "as": "center_lon"
        },
        {
          "calculate": "(datum.binned_lat + datum.binned_lat_end) / 2",
          "as": "center_lat"
        },
        {
          "aggregate": [{"op": "count", "as": "campsite_count"}],
          "groupby": ["center_lon", "center_lat"]
        },
        {
          "filter": "datum.campsite_count >= 3"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "size": 22,
        "color": "#7b2e01"
      },
      "encoding": {
        "longitude": {"field": "center_lon", "type": "quantitative"},
        "latitude": {"field": "center_lat", "type": "quantitative"},
        "tooltip": [
          {"field": "campsite_count", "type": "quantitative", "title": "Recorded Campsites in Zone"},
          {"field": "center_lat", "type": "quantitative", "title": "Latitude", "format": ".2f"},
          {"field": "center_lon", "type": "quantitative", "title": "Longitude", "format": ".2f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}