{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Where Are Most Campsites Located?",
    "subtitle": [
      "Source: OpenStreetMap Australia (OSM), extracted via Overpass Turbo (N = 9,930)"
    ],
    "anchor": "start",
    "font": "Playfair Display",
    "fontSize": 18,
    "fontWeight": 700,
    "color": "#1f2421",
    "subtitleFont": "Roboto",
    "subtitleFontSize": 11,
    "subtitleColor": "#5c6460",
    "subtitleFontStyle": "italic",
    "dy": -8
  },
  "width": 750,
  "height": 520,
  "projection": {
    "type": "equirectangular",
    "center": [133.7751, -26.5],
    "scale": 780
  },
  "layer": [
    {
      "description": "Base Australia map",
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f5efe6",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "Dot map (1 dot = 3 campsites)",
      "data": {
        "url": "data/campsites_coastal_distribution.csv"
      },
      "transform": [
        {
          "bin": {"step": 0.35},
          "field": "lon",
          "as": ["binned_lon", "binned_lon_end"]
        },
        {
          "bin": {"step": 0.35},
          "field": "lat",
          "as": ["binned_lat", "binned_lat_end"]
        },
        {
          "calculate": "(datum.binned_lon + datum.binned_lon_end) / 2",
          "as": "center_lon"
        },
        {
          "calculate": "(datum.binned_lat + datum.binned_lat_end) / 2",
          "as": "center_lat"
        },
        {
          "aggregate": [{"op": "count", "as": "campsite_count"}],
          "groupby": ["center_lon", "center_lat"]
        },
        {
          "filter": "datum.campsite_count >= 3"
        },
        {
          "calculate": "'1 Dot = 3 Campsites'",
          "as": "dot_ratio"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "size": 22
      },
      "encoding": {
        "longitude": {"field": "center_lon", "type": "quantitative"},
        "latitude": {"field": "center_lat", "type": "quantitative"},
        "color": {
          "field": "dot_ratio",
          "type": "nominal",
          "scale": {
            "domain": ["1 Dot = 3 Campsites"],
            "range": ["#7b2e01"]
          },
          "legend": {
            "title": "Legend",
            "orient": "bottom-left",
            "symbolType": "circle",
            "symbolSize": 70,
            "titleFont": "Roboto",
            "titleFontSize": 11,
            "titleFontWeight": "bold",
            "titleColor": "#1f2421",
            "labelFont": "Roboto",
            "labelFontSize": 11,
            "labelColor": "#5c6460",
            "fillColor": "rgba(255, 255, 255, 0.85)",
            "strokeColor": "#e7e2d9",
            "padding": 6,
            "cornerRadius": 4
          }
        },
        "tooltip": [
          {"field": "campsite_count", "type": "quantitative", "title": "Recorded Campsites in Zone"},
          {"field": "center_lat", "type": "quantitative", "title": "Latitude", "format": ".2f"},
          {"field": "center_lon", "type": "quantitative", "title": "Longitude", "format": ".2f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Roboto"
  }
}