{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "The Remoteness Penalty: Campsite Amenity Deficit",
    "subtitle": [
      "Comparison of facility availability between Coastal/Urban Holiday Parks and Remote Outback Bushcamps",
      "Sources: Synthesized from OpenStreetMap Australia (OSM) & DBCA/TRA Camper Cohort Surveys"
    ],
    "anchor": "start",
    "font": "Playfair Display",
    "fontSize": 17,
    "fontWeight": 700,
    "color": "#1f2421",
    "subtitleFont": "Roboto",
    "subtitleFontSize": 13,
    "subtitleColor": "#64748b",
    "subtitleFontStyle": "italic",
    "dy": -8
  },
  "width": 600,
  "height": 440,
  "data": {
    "url": "data/amenities_remoteness_gap.csv"
  },
  "transform": [
    {
      "calculate": "(datum.coastal_urban + datum.remote_outback) / 2",
      "as": "midpoint_x"
    },
    {
      "calculate": "'-' + datum.gap + '% deficit'",
      "as": "gap_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "amenity",
      "type": "nominal",
      "sort": {"field": "coastal_urban", "order": "descending"},
      "axis": {
        "title": null,
        "labelFont": "Roboto",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelColor": "#1f2421",
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "description": "Connecting Rule (Dumbbell Bar encoding the Gap)",
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 3.5,
        "strokeCap": "round"
      },
      "encoding": {
        "x": {
          "field": "remote_outback",
          "type": "quantitative",
          "scale": {"domain": [0, 100]},
          "axis": {
            "title": "Facility Availability Rate (%)",
            "titleFont": "Roboto",
            "titleFontSize": 11,
            "labelFont": "Roboto",
            "labelFontSize": 10,
            "grid": true,
            "gridColor": "#f1f5f9"
          }
        },
        "x2": {"field": "coastal_urban"}
      }
    },
    {
      "description": "Rural / Outback Dot (Teal)",
      "mark": {
        "type": "point",
        "size": 180,
        "filled": true,
        "opacity": 1
      },
      "encoding": {
        "x": {"field": "remote_outback", "type": "quantitative"},
        "color": {
          "datum": "Rural / Outback",
          "type": "nominal",
          "scale": {
            "domain": ["City / Coastal", "Rural / Outback"],
            "range": ["#d97706", "#0f766e"]
          },
          "legend": {
            "title": "Location",
            "orient": "bottom-right",
            "symbolSize": 120,
            "titleFont": "Roboto",
            "titleFontSize": 11,
            "labelFont": "Roboto",
            "labelFontSize": 11,
            "labelColor": "#1f2421"
          }
        },
        "tooltip": [
          {"field": "amenity", "type": "nominal", "title": "Facility"},
          {"field": "remote_outback", "type": "quantitative", "title": "Rural / Outback Rate (%)", "format": ".1f"},
          {"field": "gap", "type": "quantitative", "title": "Remoteness Penalty (%)", "format": ".1f"}
        ]
      }
    },
    {
      "description": "City / Coastal Dot (Orange)",
      "mark": {
        "type": "point",
        "size": 180,
        "filled": true,
        "opacity": 1
      },
      "encoding": {
        "x": {"field": "coastal_urban", "type": "quantitative"},
        "color": {
          "datum": "City / Coastal",
          "type": "nominal"
        },
        "tooltip": [
          {"field": "amenity", "type": "nominal", "title": "Facility"},
          {"field": "coastal_urban", "type": "quantitative", "title": "City / Coastal Rate (%)", "format": ".1f"},
          {"field": "gap", "type": "quantitative", "title": "Remoteness Penalty (%)", "format": ".1f"}
        ]
      }
    },
    {
      "description": "Gap Annotation Text positioned midway along the rule",
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "font": "Roboto",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#64748b"
      },
      "encoding": {
        "x": {
          "field": "midpoint_x",
          "type": "quantitative"
        },
        "text": {
          "field": "gap_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}