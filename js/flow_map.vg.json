{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
    "title": {
    "text": "Interstate Camper Flows into Western Australia",
    "subtitle": [
      "Origin-to-destination volume of interstate campers travelling to WA National & Conservation Parks (n = 886)",
      "Source: DBCA WA Camping Experience Study (2025, Page 14)"
    ],
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#64748b",
    "subtitleFontStyle": "italic"
  },
  "width": 700,
  "height": 480,
  "projection": {
    "type": "equirectangular",
    "center": [133.7751, -27.0],
    "scale": 700
  },
  "layer": [
    {
      "description": "Base Australia State Boundaries",
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f5efe6",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.9
      }
    },
    {
      "description": "Flow Trajectory Lines",
      "data": {
        "url": "data/campers_to_WA.csv"
      },
      "mark": {
        "type": "rule",
        "color": "#0284c7",
        "opacity": 0.55,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {"field": "o_lon", "type": "quantitative"},
        "latitude": {"field": "o_lat", "type": "quantitative"},
        "longitude2": {"field": "d_lon"},
        "latitude2": {"field": "d_lat"},
        "strokeWidth": {
          "field": "camper_share",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "range": [1.5, 9]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "origin", "type": "nominal", "title": "Origin State"},
          {"field": "dest", "type": "nominal", "title": "Destination"},
          {"field": "camper_share", "type": "quantitative", "title": "Share of Campers (%)", "format": ".1f"},
          {"field": "sample_count", "type": "quantitative", "title": "Sampled Campers (n)", "format": ","}
        ]
      }
    },
    {
      "description": "Directional Flow Arrowheads",
      "data": {
        "values": [
          {"origin": "VICTORIA", "lon": 129.83, "lat": -34.76, "angle": 281.4, "people": 64, "camper_share": 7.2},
          {"origin": "NEW SOUTH WALES", "lon": 132.83, "lat": -32.87, "angle": 273.1, "people": 38, "camper_share": 4.3},
          {"origin": "QUEENSLAND", "lon": 133.70, "lat": -29.80, "angle": 263.1, "people": 34, "camper_share": 3.8},
          {"origin": "SOUTH AUSTRALIA",  "lon": 126.78, "lat": -33.38, "angle": 277.5, "people": 24, "camper_share": 2.7},
          {"origin": "TASMANIA", "lon": 130.97, "lat": -37.20, "angle": 289.2, "people": 8,  "camper_share": 0.9},
          {"origin": "NORTHERN TERRITORY",  "lon": 123.05, "lat": -22.59, "angle": 217.5, "people": 8,  "camper_share": 0.9},
          {"origin": "AUSTRALIAN CAPITAL TERRITORY", "lon": 131.83, "lat": -33.55, "angle": 275.7, "people": 2,  "camper_share": 0.2}
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle",
        "filled": true,
        "color": "#0284c7",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "angle": {
          "field": "angle",
          "type": "quantitative",
          "scale": null
        },
        "size": {
          "field": "people",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "range": [50, 420]
          },
          "legend": {
            "title": "Campers (Sampled n)",
            "orient": "bottom-left"
          }
        },
        "tooltip": [
          {"field": "origin", "type": "nominal", "title": "Origin State"},
          {"field": "people", "type": "quantitative", "title": "Campers (n)", "format": ","},
          {"field": "camper_share", "type": "quantitative", "title": "Share of Campers (%)", "format": ".1f"}
        ]
      }
    },
    {
      "description": "Origin State Nodes",
      "data": {
        "url": "data/campers_to_WA.csv"
      },
      "mark": {
        "type": "circle",
        "size": 55,
        "color": "#0284c7",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {"field": "o_lon", "type": "quantitative"},
        "latitude": {"field": "o_lat", "type": "quantitative"}
      }
    },
    {
      "description": "Destination Node: Western Australia Parks Hub",
      "data": {
        "values": [
          {"dest": "WA Parks Hub", "lon": 115.86, "lat": -31.95}
        ]
      },
      "mark": {
        "type": "circle",
        "size": 180,
        "color": "#0f172a",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [
          {"field": "dest", "type": "nominal", "title": "Destination Hub"},
          {"value": "Primary destination for 886 surveyed park campers", "title": "Note"}
        ]
      }
    },
    {
      "description": "Origin Labels",
      "data": {
        "url": "data/campers_to_WA.csv"
      },
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 10,
        "dy": -10,
        "color": "#1e293b"
      },
      "encoding": {
        "longitude": {"field": "o_lon", "type": "quantitative"},
        "latitude": {"field": "o_lat", "type": "quantitative"},
        "text": {"field": "origin", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}