{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Where to camp in each season?",
    "subtitle": [
      "Bubble size denotes camper preference share (%); colour indicates overall seasonal camping condition.",
      "Scroll through the seasons to watch demand invert.",
      "Source: OpenStreetMap Australia (OSM), extracted via Overpass Turbo (N = 9,930)"

    ],
    "anchor": "start",
    "font": "Playfair Display",
    "fontSize": 17,
    "fontWeight": 700,
    "color": "#1f2421",
    "subtitleFont": "Roboto",
    "subtitleFontSize": 13,
    "subtitleColor": "#5c6460",
    "subtitleFontStyle": "italic"
  },
 "width": 800,
  "height": 600,
  "projection": {
    "type": "equirectangular",
    "center": [133.7751, -27.0],
    "scale": 720
  },
  "params": [
    {
      "name": "season_filter",
      "value": "Summer"
    }
  ],
  "layer": [
    {
      "description": "Base Australia Outline Map",
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f5efe6",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "Regional Camping Demand & Climate Bubbles",
      "data": {
        "url": "data/campsite_seasonal_migration_map.csv"
      },
      "transform": [
        {
          "filter": "datum.season === season_filter"
        },
        {
          "calculate": "datum.suitability_tier === 'Optimal / Peak Season' ? 'Peak Season' : (datum.suitability_tier === 'Moderate / Shoulder' ? 'Moderate' : 'Bad / Avoid')",
          "as": "simple_status"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#0f172a",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
  "field": "camper_preference_pct",
  "type": "quantitative",
  "scale": {
    "type": "pow",
    "exponent": 1.6,
    "domain": [5, 100],
    "range": [30, 2400]
  },
  "legend": {
    "title": "Camper Preference (%)",
    "values": [10, 50, 95],
    "orient": "bottom-left"
  }
},
        "color": {
          "field": "simple_status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Peak Season",
              "Moderate",
              "Bad / Avoid"
            ],
            "range": [
              "#4eb004",
              "#00b7c4",
              "#b06804"
            ]
          },
          "legend": {
            "title": "Season Condition",
            "orient": "bottom-left",
            "symbolSize": 90,
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {"field": "region", "type": "nominal", "title": "Destination Hub"},
          {"field": "season", "type": "nominal", "title": "Selected Season"},
          {"field": "simple_status", "type": "nominal", "title": "Condition Rating"},
          {"field": "camper_preference_pct", "type": "quantitative", "title": "Preference Share (%)"},
          {"field": "avg_day_temp_c", "type": "quantitative", "title": "Avg Day Temp (°C)"},
          {"field": "rainfall_mm", "type": "quantitative", "title": "Seasonal Rainfall (mm)"},
          {"field": "suitability_tier", "type": "nominal", "title": "Climate Detail / Hazard"},
          {"field": "why_they_camp_here", "type": "nominal", "title": "Travel Motivation / Hazard Note"}
        ]
      }
    },
    {
      "description": "Region Label Text",
      "data": {
        "url": "data/campsite_seasonal_migration_map.csv"
      },
      "transform": [
        {
          "filter": "datum.season === season_filter"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 10.5,
        "dy": -16,
        "color": "#0f172a"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "region", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}