{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Demographic Profile of Australian Campers",
    "subtitle": [
      "Age cohort and gender breakdown of park campers (N = 892)",
      "Source: DBCA WA Camping Experience Study (2025, Page 13)"
    ],
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#64748b",
    "subtitleFontStyle": "italic"
  },
  "width": 700,
  "height": 440,
  "data": {
    "url": "data/age_group_gender_share.csv"
  },
  "transform": [
    {
      "calculate": "datum.gender === 'Female' ? -datum.share : datum.share",
      "as": "signed_share"
    },
    {
  "calculate": "format(datum.share, '.1f') + '%'",
  "as": "share_pct"
}
  ],
  "layer": [
    {
      "description": "Bilateral population pyramid bars",
      "mark": {
        "type": "bar",
        "cornerRadius": 2
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65-74", "75+"],
          "axis": {
            "title": "Age Cohort",
            "domain": false,
            "ticks": false,
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "x": {
          "field": "signed_share",
          "type": "quantitative",
          "scale": {
            "domain": [-16, 21]
          },
          "axis": {
            "title": "← Female (%)          Male (%) →",
            "values": [-16, -12, -8, -4, 0, 4, 8, 12, 16],
            "labelExpr": "abs(datum.value) + '%'",
            "grid": true
          }
        },
        "color": {
          "field": "gender",
          "type": "nominal",
          "scale": {
            "domain": ["Female", "Male"],
            "range": ["#b45309", "#334155"]
          },
          "legend": {
            "orient": "top-right",
            "title": null,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "age_group", "type": "nominal", "title": "Age Cohort"},
          {"field": "gender", "type": "nominal", "title": "Gender"},
{"field": "share_pct", "type": "nominal", "title": "Share of Campers"}        ]
      }
    },
    
    {
      "description": "Multi-line text inside enlarged box",
      "data": {
        "values": [
          {
            "age_group": "45-54",
            "x": 17.6,
            "text": ["Peak Demographic", "45-54"]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#7b2e01",
        "lineHeight": 15
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65-74", "75+"]
        },
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "text"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}